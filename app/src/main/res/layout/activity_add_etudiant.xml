<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:text="Ajouter un étudiant"
            android:textSize="22sp"
            android:textColor="#0D47A1"
            android:textStyle="bold"
            android:paddingBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Nom :"
            style="@style/labelStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etNom"
            android:hint="Entrez le nom"
            android:inputType="textPersonName"
            android:background="@android:drawable/edit_text"
            style="@style/champStyle"/>

        <TextView
            android:text="Prénom :"
            style="@style/labelStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <EditText
            android:id="@+id/etPrenom"
            android:hint="Entrez le prénom"
            android:inputType="textPersonName"
            android:background="@android:drawable/edit_text"
            style="@style/champStyle"/>

        <TextView
            android:text="Ville :"
            style="@style/labelStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Spinner
            android:id="@+id/spinVille"
            android:entries="@array/villes"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Sexe :"
            style="@style/labelStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <RadioGroup
            android:id="@+id/rgSexe"
            android:orientation="horizontal"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/rbHomme"
                android:text="Homme"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/rbFemme"
                android:text="Femme"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnAjouter"
            android:text="Ajouter"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>